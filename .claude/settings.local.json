{
  "permissions": {
    "allow": [
      "Bash(.venv\\\\Scripts\\\\python.exe -m pytest tests/ -v)",
      "Bash(New-Item -ItemType Directory -Force \"C:\\\\repos\\\\trumpStockAlert\\\\docs\")",
      "Bash(Out-Null)",
      "Bash(New-Item -ItemType File -Force \"C:\\\\repos\\\\trumpStockAlert\\\\docs\\\\README.md\")",
      "PowerShell(New-Item *)",
      "Bash(grep -E \"\\\\.\\(py|sh|txt|toml|yaml|yml\\)$\")",
      "Bash(python -m pytest tests/ -v)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/prettier-frontend.ps1"
          }
        ]
      }
    ]
  }
}
